{
  "name": "ai-testcase-server",
  "version": "1.0.0",
  "description": "Backend service for AI Test Case Generator and Management System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --openssl-legacy-provider node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/index.ts",
    "build": "npx tsc",
    "start": "node --openssl-legacy-provider dist/index.js",
    "seed": "node --openssl-legacy-provider node_modules/ts-node-dev/lib/bin.js --transpile-only src/seed.ts",
    "seed:prod": "node --openssl-legacy-provider dist/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@marsaud/smb2": "^0.18.0",
    "@prisma/client": "^5.19.1",
    "basic-ftp": "^5.0.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "openai": "^4.58.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.21.0",
    "prisma": "^5.19.1",
    "ts-node-dev": "^2.0.0"
  }
}
