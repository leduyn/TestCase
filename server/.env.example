PORT=3001
NODE_ENV=development

# PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/testcase_db?schema=public&connection_limit=20&statement_timeout=30000&idle_in_transaction_session_timeout=60000"

# Example Neon.tech PostgreSQL URL (replace with your real credentials):
# DATABASE_URL="postgresql://neondb_owner:<PASSWORD>@<host>.neon.tech/neondb?sslmode=require"

# JWT Secret Key
JWT_SECRET=super_secret_jwt_key_testcase_ai_2026

# Default AI API Keys (Optional - can be overridden via UI Settings)
# DO NOT PUT REAL SECRETS IN THIS EXAMPLE FILE!
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Redis (Socket.IO adapter + permission cache). Optional — thiếu thì chạy memory fallback.
# Prod LAN: REDIS_URL=redis://:matkhau@192.168.1.234:6379/0
REDIS_URL=
REDIS_RETRY_INTERVAL_MS=10000
