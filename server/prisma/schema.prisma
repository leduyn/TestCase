// Prisma Schema for AI Test Case Generator & Management System

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TESTER
  VIEWER
  MANAGER
  USER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskHistoryChangeType {
  CREATED
  UPDATED
  STEP_CHANGED
  FIELD_UPDATED
  COMPLETED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum Priority {
  CAO
  TRUNG_BINH
  THAP
}

enum TestExecutionStatus {
  UNTESTED
  PASSED
  FAILED
  BLOCKED
  RETEST
}

enum TestCaseReviewStatus {
  UNREVIEWED
  REVIEWED
}

enum PermissionEffect {
  ALLOW
  DENY
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  category    String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           String       @id @default(uuid())
  role         Role
  permissionId String       @map("permission_id")
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime     @default(now()) @map("granted_at")
  grantedById  String?      @map("granted_by_id")
  grantedBy    User?        @relation("GrantedRolePermissions", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String            @id @default(uuid())
  userId       String            @map("user_id")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String            @map("permission_id")
  permission   Permission        @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       PermissionEffect  @default(ALLOW)
  resourceType String?           @map("resource_type")
  resourceId   String?           @map("resource_id")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@unique([userId, permissionId, resourceType, resourceId])
  @@map("user_permissions")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String            @map("password_hash")
  fullName          String            @map("full_name")
  role              Role              @default(TESTER)
  status            UserStatus        @default(ACTIVE)
  lastLogin         DateTime?         @map("last_login")
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  passwordExpiry    DateTime?         @map("password_expiry")
  
  createdById       String?           @map("created_by")
  createdBy         User?             @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers      User[]            @relation("UserCreatedBy")
  updatedById       String?           @map("updated_by")
  updatedBy         User?             @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedUsers      User[]            @relation("UserUpdatedBy")

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  documents             Document[]
  executions            TestExecution[]
  beforeExecutions      TestExecution[] @relation("BeforeExecution")
  createdExecutions     TestExecution[] @relation("CreatedExecution")
  reviewedTestCases     TestCase[] @relation("ReviewedBy")
  aiConfigs             AiConfig[]
  userPermissions       UserPermission[]
  grantedRolePermissions RolePermission[] @relation("GrantedRolePermissions")
  watchedExecutions      TestExecutionWatcher[]
  historyExecutions      TestExecutionHistory[] @relation("HistoryExecutedBy")
  historyBeforeExecutions TestExecutionHistory[] @relation("HistoryBeforeExecutedBy")
  historyCreatedExecutions TestExecutionHistory[] @relation("HistoryCreatedBy")
  statusHandlers         ExecutionStatusHandler[]

  managedProcesses      Process[]         @relation("ManagedProcesses")
  createdProcesses      Process[]         @relation("CreatedProcesses")
  updatedProcesses      Process[]         @relation("UpdatedProcesses")
  deletedProcesses      Process[]         @relation("DeletedProcesses")
  createdProcessSteps   ProcessStep[]     @relation("CreatedProcessSteps")
  updatedProcessSteps   ProcessStep[]     @relation("UpdatedProcessSteps")
  createdTasks          Task[]            @relation("CreatedTasks")
  updatedTasks          Task[]            @relation("UpdatedTasks")
  previousExecutorTasks Task[]            @relation("TaskPreviousExecutor")
  executedTodos         Todo[]            @relation("TodoExecutor")
  createdTodos          Todo[]            @relation("CreatedTodos")
  updatedTodos          Todo[]            @relation("UpdatedTodos")
  taskComments          TaskComment[]     @relation("TaskCommentUser")
  createdTaskComments   TaskComment[]     @relation("CreatedTaskComments")
  updatedTaskComments   TaskComment[]     @relation("UpdatedTaskComments")
  changedTaskHistories  TaskHistory[]     @relation("TaskHistoryChangedBy")
  createdTaskHistories  TaskHistory[]     @relation("CreatedTaskHistories")

  createdCustomFieldDefinitions CustomFieldDefinition[] @relation("CreatedCustomFieldDefinitions")
  updatedCustomFieldDefinitions CustomFieldDefinition[] @relation("UpdatedCustomFieldDefinitions")
  filledTaskCustomFields        TaskCustomFieldValue[]  @relation("FilledTaskCustomFields")
  updatedTaskCustomFields       TaskCustomFieldValue[]  @relation("UpdatedTaskCustomFields")

  @@map("users")
}

model Document {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  fileType    String      @map("file_type")
  fileSize    Int         @default(0) @map("file_size")
  rawContent  String      @db.Text @map("raw_content")
  createdAt   DateTime    @default(now()) @map("created_at")

  testSuites  TestSuite[]

  @@map("documents")
}

model TestSuite {
  id          String      @id @default(uuid())
  documentId  String?     @map("document_id")
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  name        String
  moduleName  String      @map("module_name")
  summary     String?     @db.Text
  assumptions String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  testCases   TestCase[]

  @@map("test_suites")
}

model TestCase {
  id             String          @id @default(uuid())
  testSuiteId    String          @map("test_suite_id")
  testSuite      TestSuite       @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  testCaseCode   String          @map("test_case_code") // e.g. TC_KH_001
  module         String
  platform       String          // App, CMS, Web, etc.
  title          String
  testType       String          @map("test_type") // Luồng chuẩn, Luồng ngoại lệ, Giá trị biên
  preconditions  String          @db.Text
  steps          String          @db.Text
  expectedResult String          @db.Text @map("expected_result")
  priority       String          @default("Cao") // Cao, Trung bình, Thấp
  orderIndex     Int             @default(0) @map("order_index")
  reviewStatus   TestCaseReviewStatus @default(UNREVIEWED) @map("review_status")
  reviewedById   String?         @map("reviewed_by_id")
  reviewedBy     User?           @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?       @map("reviewed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  executions     TestExecution[]

  @@map("test_cases")
}

model TestExecution {
  id           String              @id @default(uuid())
  testCaseId   String              @map("test_case_id")
  testCase     TestCase            @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executedById String?             @map("executed_by_id")
  executedBy   User?               @relation(fields: [executedById], references: [id], onDelete: SetNull)

  beforeExecutedId String?         @map("before_executed_id")
  beforeExecutedBy User?               @relation("BeforeExecution", fields: [beforeExecutedId], references: [id], onDelete: SetNull)

  createdById  String?            @map("created_by_id")
  createdBy    User?              @relation("CreatedExecution", fields: [createdById], references: [id], onDelete: SetNull)

  server       String?             // DEV, STAGING, UAT, PROD, IP...
  os           String?             // Windows 11, macOS, Android 14, iOS 17...
  status       TestExecutionStatus @default(UNTESTED)
  actualResult String?             @db.Text @map("actual_result")
  evaluation   String?             @db.Text
  notes        String?             @db.Text
  
  executedAt   DateTime            @default(now()) @map("executed_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  images       TestExecutionImage[]
  watchers      TestExecutionWatcher[]
  history       TestExecutionHistory[]

  @@map("test_executions")
}

model TestExecutionWatcher {
  id           String        @id @default(uuid())
  executionId  String        @map("execution_id")
  execution    TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now()) @map("created_at")

  @@unique([executionId, userId])
  @@map("test_execution_watchers")
}

model TestExecutionHistory {
  id               String              @id @default(uuid())
  executionId      String              @map("execution_id")
  execution        TestExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  testCaseId       String              @map("test_case_id")
  executedById     String?             @map("executed_by_id")
  executedBy       User?               @relation("HistoryExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)
  beforeExecutedId String?             @map("before_executed_id")
  beforeExecutedBy User?               @relation("HistoryBeforeExecutedBy", fields: [beforeExecutedId], references: [id], onDelete: SetNull)
  createdById      String?             @map("created_by_id")
  createdBy        User?               @relation("HistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  server           String?
  os               String?
  status           TestExecutionStatus @default(UNTESTED)
  actualResult     String?             @db.Text @map("actual_result")
  evaluation       String?             @db.Text
  notes            String?             @db.Text
  images           Json?               @default("[]") @map("images")
  executedAt       DateTime            @map("executed_at")
  updatedAt        DateTime            @map("updated_at")

  @@map("test_execution_histories")
}

// Danh sách người dùng được gán xử lý từng trạng thái thực thi.
// Chỉ user có mặt trong danh sách của một trạng thái mới được chuyển execution
// sang trạng thái đó và được hiển thị để giao việc cho trạng thái đích.
model ExecutionStatusHandler {
  id        String   @id @default(uuid())
  status    String   @map("status") // UNTESTED | RETEST | PASSED | FAILED | BLOCKED
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([status, userId])
  @@map("execution_status_handlers")
}

model TestExecutionImage {
  id              String        @id @default(uuid())
  executionId     String        @map("execution_id")
  execution       TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  filename        String
  storagePath     String        @map("storage_path")
  storageType     String        @map("storage_type")  // local | smb | ftp | google_drive
  mimeType        String        @map("mime_type")
  fileSize        Int           @map("file_size")
  publicUrl       String?       @map("public_url")
  thumbnailPath   String?       @map("thumbnail_path")
  uploadedAt      DateTime      @default(now()) @map("uploaded_at")

  @@map("test_execution_images")
}

model AiConfig {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   // gemini, openai, anthropic, deepseek, custom
  apiKey     String   @map("api_key")
  modelName  String   @map("model_name")
  baseUrl    String?  @map("base_url")
  isActive   Boolean  @default(false) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("ai_configs")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Process {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  managerId   String        @map("manager_id")
  manager     User          @relation("ManagedProcesses", fields: [managerId], references: [id], onDelete: Restrict)
  watcherIds  Json?         @default("[]") @map("watcher_ids")

  createdById String?       @map("created_by")
  createdBy   User?         @relation("CreatedProcesses", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedById String?       @map("updated_by")
  updatedBy   User?         @relation("UpdatedProcesses", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")
  deletedById String?       @map("deleted_by")
  deletedBy   User?         @relation("DeletedProcesses", fields: [deletedById], references: [id], onDelete: SetNull)

  steps        ProcessStep[]
  tasks        Task[]
  customFields CustomFieldDefinition[]

  @@map("processes")
}

model ProcessStep {
  id             String    @id @default(uuid())
  processId      String    @map("process_id")
  process        Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  name           String
  executorIds    Json?     @default("[]") @map("executor_ids")
  timeLimitHours Int       @default(24) @map("time_limit_hours")
  order          Int       @map("order")
  instructions   String?   @db.Text @map("instructions")

  createdById    String?   @map("created_by")
  createdBy      User?     @relation("CreatedProcessSteps", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedById    String?   @map("updated_by")
  updatedBy      User?     @relation("UpdatedProcessSteps", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tasks                  Task[]
  customFields           CustomFieldDefinition[]
  taskCustomFieldValues  TaskCustomFieldValue[]

  @@map("process_steps")
}

model CustomFieldDefinition {
  id                  String       @id @default(uuid())
  processId           String       @map("process_id")
  process             Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  stepId              String?      @map("step_id")
  step                ProcessStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
  fieldKey            String       @map("field_key")
  fieldLabel          String       @map("field_label")
  fieldType           String       @map("field_type") // text, textarea, richtext, number, date, datetime, select, multiselect, radio, checkbox, toggle, file, multifile, user, multiuser, email, phone, url, rating, slider, color, formula
  fieldConfig         Json         @default("{}") @map("field_config")
  isRequired          Boolean      @default(false) @map("is_required")
  defaultValue        Json?        @map("default_value")
  placeholder         String?
  helpText            String?      @map("help_text")
  order               Int          @default(0) @map("order")
  isVisible           Boolean      @default(true) @map("is_visible")
  visibilityCondition Json?        @map("visibility_condition")
  validationRules     Json?        @map("validation_rules")

  createdById         String?      @map("created_by")
  createdBy           User?        @relation("CreatedCustomFieldDefinitions", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedById         String?      @map("updated_by")
  updatedBy           User?        @relation("UpdatedCustomFieldDefinitions", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt           DateTime     @updatedAt @map("updated_at")

  taskValues          TaskCustomFieldValue[]

  @@unique([processId, fieldKey])
  @@map("custom_field_definitions")
}

model Task {
  id                 String        @id @default(uuid())
  processId          String        @map("process_id")
  process            Process       @relation(fields: [processId], references: [id], onDelete: Cascade)
  name               String
  content            String?       @db.Text @map("content")
  customFields       Json?         @map("custom_fields")
  currentStepId      String?       @map("current_step_id")
  currentStep        ProcessStep?  @relation(fields: [currentStepId], references: [id], onDelete: SetNull)
  executorIds        Json?         @default("[]") @map("executor_ids")
  watcherIds         Json?         @default("[]") @map("watcher_ids")
  previousExecutorId String?       @map("previous_executor_id")
  previousExecutor   User?         @relation("TaskPreviousExecutor", fields: [previousExecutorId], references: [id], onDelete: SetNull)
  startedAt          DateTime      @default(now()) @map("started_at")
  deadline           DateTime      @map("deadline")
  completedAt        DateTime?     @map("completed_at")
  status             TaskStatus    @default(IN_PROGRESS) @map("status")
  fileUploads        Json?         @default("[]") @map("file_uploads")

  createdById        String?       @map("created_by")
  createdBy          User?         @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedById        String?       @map("updated_by")
  updatedBy          User?         @relation("UpdatedTasks", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt          DateTime      @updatedAt @map("updated_at")

  todos              Todo[]
  comments           TaskComment[]
  histories          TaskHistory[]
  customFieldValues  TaskCustomFieldValue[]

  @@map("tasks")
}

model TaskCustomFieldValue {
  id                String                @id @default(uuid())
  taskId            String                @map("task_id")
  task              Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fieldDefinitionId String                @map("field_definition_id")
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  value             Json?                 @map("value")
  stepId            String?               @map("step_id")
  step              ProcessStep?          @relation(fields: [stepId], references: [id], onDelete: SetNull)

  filledById        String?               @map("filled_by_id")
  filledBy          User?                 @relation("FilledTaskCustomFields", fields: [filledById], references: [id], onDelete: SetNull)
  filledAt          DateTime              @default(now()) @map("filled_at")
  updatedById       String?               @map("updated_by")
  updatedBy         User?                 @relation("UpdatedTaskCustomFields", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([taskId, fieldDefinitionId])
  @@map("task_custom_field_values")
}

model Todo {
  id          String    @id @default(uuid())
  taskId      String    @map("task_id")
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  description String    @db.Text
  executorId  String?   @map("executor_id")
  executor    User?     @relation("TodoExecutor", fields: [executorId], references: [id], onDelete: SetNull)
  deadline    DateTime? @map("deadline")
  watcherIds  Json?     @default("[]") @map("watcher_ids")
  files       Json?     @default("[]") @map("files")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")

  createdById String?   @map("created_by")
  createdBy   User?     @relation("CreatedTodos", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedById String?   @map("updated_by")
  updatedBy   User?     @relation("UpdatedTodos", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("todos")
}

model TaskComment {
  id          String   @id @default(uuid())
  taskId      String   @map("task_id")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation("TaskCommentUser", fields: [userId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  files       Json?    @default("[]") @map("files")

  createdById String?  @map("created_by")
  createdBy   User?    @relation("CreatedTaskComments", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedById String?  @map("updated_by")
  updatedBy   User?    @relation("UpdatedTaskComments", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("task_comments")
}

model TaskHistory {
  id                String                @id @default(uuid())
  taskId            String                @map("task_id")
  task              Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  version           Int                   @default(1) @map("version")
  changedById       String?               @map("changed_by")
  changedBy         User?                 @relation("TaskHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changeType        TaskHistoryChangeType @map("change_type")
  changeDescription String?               @db.Text @map("change_description")
  snapshot          Json                  @map("snapshot")

  createdById       String?               @map("created_by")
  createdBy         User?                 @relation("CreatedTaskHistories", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now()) @map("created_at")

  @@map("task_histories")
}

